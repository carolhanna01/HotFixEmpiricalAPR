author = {Li, Fengjie and Jiang, Jiajun and Sun, Jiajun and Zhang, Hongyu},
doi = {10.1145/3715004/ASSET/2CF92A78-1486-4D10-939A-C9E9094FA273/ASSETS/IMAGES/LARGE/TOSEM-2024-0438-F07.JPG},
eprint = {2406.00992},
file = {:C\:/Users/carol/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Li et al. - 2025 - Hybrid Automated Program Repair by Combining Large Language Models and Program Analysis.pdf:pdf},
issn = {1049-331X},
journal = {ACM Transactions on Software Engineering and Methodology},
keywords = {Large Language Model,Program Repair,Program Synthesis,benchmark-specific,defects4j},
